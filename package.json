{
  "name": "globalization-workflow-lab",
  "version": "1.0.0",
  "description": "Hybrid localisation QA pipeline for it-IT: deterministic checks, AI linguistic evaluation, and policy-based decision making with OpenAI, Claude, or Ollama",
  "main": "src/runQa.ts",
  "scripts": {
    "qa": "tsx src/runQa.ts",
    "benchmark": "tsx src/evaluation/runBenchmark.ts",
    "benchmark:ai:openai": "tsx --env-file=.env src/evaluation/runAiBenchmark.ts --provider=openai",
    "benchmark:ai:claude": "tsx --env-file=.env src/evaluation/runAiBenchmark.ts --provider=anthropic",
    "benchmark:ai:ollama": "tsx --env-file=.env src/evaluation/runAiBenchmark.ts --provider=ollama",
    "qa:ai": "tsx --env-file=.env src/runAiQa.ts",
    "qa:ai:openai": "tsx --env-file=.env src/runAiQa.ts --provider=openai",
    "qa:ai:claude": "tsx --env-file=.env src/runAiQa.ts --provider=anthropic",
    "qa:ai:ollama": "tsx --env-file=.env src/runAiQa.ts --provider=ollama",
    "qa:hybrid:openai": "tsx --env-file=.env src/runHybridQa.ts --provider=openai",
    "qa:hybrid:claude": "tsx --env-file=.env src/runHybridQa.ts --provider=anthropic",
    "qa:hybrid:ollama": "tsx --env-file=.env src/runHybridQa.ts --provider=ollama"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ACoci86/globalization-workflow-lab.git"
  },
  "keywords": [
    "localization",
    "l10n",
    "qa",
    "italian",
    "llm"
  ],
  "author": "Alessio Coci",
  "license": "MIT",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/ACoci86/globalization-workflow-lab/issues"
  },
  "homepage": "https://github.com/ACoci86/globalization-workflow-lab#readme",
  "devDependencies": {
    "@types/node": "^22.20.2",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
